# Variables de entorno del backend (copiar a .env y ajustar):
#   cp .env.example .env

NODE_ENV=development

# Secreto para firmar los JWT (64 bytes en hexadecimal).
JWT_TOKEN=poner_un_secreto_de_64_bytes_aqui

# Orígenes permitidos para CORS (lista separada por comas).
CORS_ORIGINS=http://localhost:5173

# Zona horaria del servidor. Importante en producción: Vercel corre en UTC y
# los informes/comprobantes formatean fechas con la hora local del proceso.
TZ=America/Argentina/Buenos_Aires

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Desarrollo local (MySQL, es el dialecto por defecto):
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tesis_2026
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Producción (Supabase = PostgreSQL). Se puede usar una URL completa:
# DB_DIALECT=postgres
# DB_URL=postgresql://USUARIO.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DB_SSL=true
# DB_POOL_MAX=3
#
# La URL de Supabase se copia desde el dashboard: Connect > Transaction pooler
# (puerto 6543, recomendado para Vercel) o Session pooler (puerto 5432, como
# alternativa si aparece un error de prepared statements). El usuario del
# pooler tiene la forma <rol>.<project_ref>, por ejemplo
# parkcontrol_app.bhjfgamjfepnqkllbref.
#
# Si se prefiere no usar DB_URL, también se aceptan las variables sueltas:
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_PORT=6543
# DB_USER=ROL.PROJECT_REF
# DB_PASSWORD=...
# DB_NAME=postgres

# Opcionales:
# DB_POOL_MAX=3        # conexiones por instancia (Vercel usa 3 por defecto)
# DB_LOGGING=true      # imprime el SQL de Sequelize (sólo para depurar)

# El esquema NO se sincroniza en cada arranque. Para crearlo/actualizarlo a
# mano: npm run db:sync
# DB_SYNC=true
